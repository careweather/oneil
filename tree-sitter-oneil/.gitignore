# npm
node_modules/

# Native build artifacts, regenerated by `npm install` / `node-gyp-build`.
# `src/parser.c`, `src/scanner.c`, `src/grammar.json`, and `src/node-types.json`
# are intentionally *not* ignored: per `package.json`'s `files` list, they're
# committed/published so consumers can build the native binding without
# needing the `tree-sitter` CLI.
build/
prebuilds/
*.node

# `tree-sitter build --wasm` output
*.wasm

# Rust bindings, if built directly from this directory
/target
Cargo.lock

# Editor/OS cruft
.DS_Store
