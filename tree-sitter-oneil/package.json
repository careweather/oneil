{
  "name": "tree-sitter-oneil",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Oneil modeling language",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "parser",
    "lexer",
    "oneil"
  ],
  "author": "Careweather",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/careweather/oneil"
  },
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.3.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.26.11"
  },
  "peerDependencies": {
    "tree-sitter": "^0.22.4"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build || exit 0",
    "generate": "tree-sitter generate",
    "start": "tree-sitter playground",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse",
    "build": "tree-sitter generate --abi=latest && node-gyp-build",
    "prebuildify": "prebuildify --napi --strip"
  },
  "tree-sitter": [
    {
      "scope": "source.oneil",
      "file-types": [
        "on",
        "one"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^oneil$"
    }
  ]
}
