# Plain parameter references inherit the referenced unit, so they need no annotation.
# References to dimensionless parameters become plain numbers, so limits and `strip`
# read them as before.

submodel child as c

Local length: L = 2 :km

Referenced power: P_c = P.c
Referenced range: R_c = R.c
Referenced gain: G_c = G.c
Referenced efficiency (0, 1): eta_c = eta.c
Local reference: L_r = L

test: strip(eta_c) == 0.9
